# Copy to .env.local for development. Never commit real values.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used to send manager invitations. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Project Settings -> Database -> Connection string, "Transaction pooler").
# Used by the import tool and the scheduled sync job, so each run is a single database transaction.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Random long string. The scheduler must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-long-random-string

# Public site URL (used in invitation and password-reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source (USportVB backend). Used with the USportVB developer's permission.
USPORTVB_API_BASE=https://relevant-benni-volleyball-app-71b883ac.koyeb.app
SOURCE_USER_AGENT=SideoutFantasy/0.1 (private OUA league; contact via league admin)
